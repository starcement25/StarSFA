<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="false" android:state_pressed="false">
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle" android:useLevel="false">
            <corners android:radius="30px" />
            />
            <stroke android:width="1dp" android:color="#487BB2" />
            <gradient android:angle="270" android:centerColor="#FFDADADB" android:endColor="#b9b9b9" android:startColor="#b9b9b9" />
            <!--<gradient-->
            <!--android:startColor="#f1f1f2"-->
            <!--android:centerColor="#e7e7e8"-->
            <!--android:endColor="#cfcfcf"-->
            <!--android:angle="270" />-->
            <!--FFE5E5E6
FFDADADB
FFD1D1D2-->
            <padding android:bottom="3dp" android:left="5dp" android:right="3dp" android:top="5dp" />
        </shape>

    </item>

    <item android:state_focused="true" android:state_pressed="false">
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle" android:useLevel="false">
            <corners android:radius="30px" />
            <solid android:color="@color/selected" />

            <padding android:bottom="3dp" android:left="5dp" android:right="3dp" android:top="5dp" />
        </shape>
    </item>

    <item android:state_focused="false" android:state_pressed="true">
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle" android:useLevel="false">
            <corners android:radius="30px" />
            <solid android:color="@color/selected" />

            <padding android:bottom="3dp" android:left="5dp" android:right="3dp" android:top="5dp" />
        </shape>
    </item>

</selector>
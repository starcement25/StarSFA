<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="0.0px"
    android:insetTop="0.0px"
    android:insetRight="0.0px"
    android:insetBottom="1.0px">
    <selector>
        <item android:state_pressed="true">
            <shape>
                <gradient
                    android:angle="270.0"
                    android:endColor="#7EB5D6"
                    android:startColor="#326798" />
                <!--  <corners android:radius="11.0dip" /> -->
            </shape>
        </item>
        <item>
            <shape>
                <stroke
                    android:width="1.0px"
                    android:color="#326798" />
                <gradient
                    android:angle="270.0"
                    android:endColor="#7EB5D6"
                    android:startColor="#326798" />
                <!-- <corners android:radius="10.0dip" /> -->

            </shape>
        </item>
    </selector>
</inset>

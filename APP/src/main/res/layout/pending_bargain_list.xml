<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">

            <ImageView
                android:id="@+id/imageView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_launcher_asl" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_weight="0.94"
                android:text="Medium Text"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <ImageView
                android:id="@+id/image_cancel"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_gravity="right|center_vertical"
                android:src="@drawable/bk_normbackup"
                android:visibility="gone" />
        </LinearLayout>

        <EditText
            android:id="@+id/autoCompleteTextView1"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:drawableLeft="@drawable/searchx"
            android:ems="10"
            android:hint="Type Here to Search"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:nextFocusLeft="@id/autoCompleteTextView1"
            android:nextFocusUp="@id/autoCompleteTextView1"
            android:textColor="#003399"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        >
        <TextView
            android:gravity="center"
            android:layout_marginLeft="2dp"
            style="@style/TextViewSecondaryStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:text="Date"
            />

        <TextView
            android:id="@+id/descTv"
            style="@style/TextViewSecondaryStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_weight="5"
            android:gravity="center"
            android:text="SKU Name" />

        <TextView
            android:id="@+id/invamountTv"
            android:gravity="center_vertical|right"
            style="@style/TextViewSecondaryStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:text="Qty(Case/MT)"
            />
        <TextView
            android:id="@+id/dueamountTv"
            android:gravity="center_vertical|end"
            android:layout_marginEnd="4dp"
            style="@style/TextViewSecondaryStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:text="Rate"
            />

    </LinearLayout>
    <ListView
        android:id="@+id/list"
        android:layout_width="fill_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"></ListView>
    <LinearLayout
        android:id="@+id/totalLayout"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        >
        <TextView
            android:gravity="center_vertical"
            android:layout_marginStart="15dp"
            style="@style/TextViewSecondaryStyle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Total:"
            />
        <TextView
            android:gravity="center_vertical|start"
            android:id="@+id/totalQtyTV"
            android:layout_marginLeft="4dp"
            style="@style/TextViewSecondaryStyle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"

            android:text="Qty"
            />
        <TextView
            android:id="@+id/pendingBargainTotalRateTv"
            android:gravity="center_vertical|end"
            android:layout_marginEnd="4dp"
            style="@style/TextViewSecondaryStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.9"
            android:text="Rate"
            />

    </LinearLayout>
    <Button
        android:id="@+id/create_route"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:text="Create new Route"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_cncl"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:textColor="@color/white"
        android:background="@color/colorOrangeAppGrey"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="ok" />

</LinearLayout>
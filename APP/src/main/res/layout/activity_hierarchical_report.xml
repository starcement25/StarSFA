<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <include layout="@layout/header_layout_blue" />
    <LinearLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:layout_marginTop="5dp">
        <androidx.cardview.widget.CardView
            android:id="@+id/cardView_spinner"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:layout_marginStart="20dp"
            android:layout_marginRight="20dp"
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            card_view:cardElevation="1dp"
            android:background="@drawable/spinner_material_background"
            >
            <Spinner
                android:id="@+id/customerSpinner"
                android:theme="@style/ThemeOverlay.AppCompat.Light"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.cardview.widget.CardView>
        <TextView
            android:layout_marginStart="20dp"
            android:id="@+id/textViewBargainNumber"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:textSize="20dp"
            android:text="Destination: "
            android:gravity="left|bottom"
            />
    </LinearLayout>
<!--    layout starts-->
    <LinearLayout
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            >
            <TextView
                android:background="@color/black"
                android:gravity="center"
                android:layout_marginStart="1dp"
                style="@style/TextViewSecondaryStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="Type"
                />
            <TextView
                android:background="@color/black"
                android:gravity="center"
                android:layout_marginStart="1dp"
                style="@style/TextViewSecondaryStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="Day"
                />
            <TextView
                android:layout_marginEnd="1dp"
                android:background="@color/black"
                android:gravity="center"
                android:layout_marginStart="1dp"
                style="@style/TextViewSecondaryStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="Date Range"
                />
        </LinearLayout>
        <LinearLayout
            android:background="@color/black"
            android:id="@+id/ForceInFieldLayout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            >
            <TextView
                android:background="@color/white"
                android:gravity="center"
                android:layout_marginStart="1dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="Force In Field"
                />
            <TextView
                android:background="@color/white"
                android:text="8/10 "
                android:id="@+id/forceInFieldTodayTV"
                android:gravity="center_vertical|right"
                android:layout_marginStart="1dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"

                />
            <TextView
                android:background="@color/white"
                android:id="@+id/forceInFieldMonthTV"
                android:text="10/10"
                android:layout_marginEnd="1dp"
                android:gravity="center_vertical|right"
                android:layout_marginStart="1dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                />
        </LinearLayout>

        <LinearLayout
            android:clickable="true"
            android:id="@+id/areaLayout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            >
            <TextView
                android:background="@color/black"
                android:gravity="center"
                android:layout_marginStart="1dp"
                style="@style/TextViewSecondaryStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="Area"
                />
            <TextView
                android:id="@+id/areaTodayTV"
                android:background="@color/black"
                android:gravity="center_vertical|right"
                android:layout_marginStart="1dp"
                style="@style/TextViewSecondaryStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="2/32"
                />
            <TextView
                android:id="@+id/areaMonthTV"
                android:layout_marginEnd="1dp"
                android:background="@color/black"
                android:gravity="center_vertical|right"
                android:layout_marginStart="1dp"
                style="@style/TextViewSecondaryStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="28/32"
                />
        </LinearLayout>
        <LinearLayout
            android:background="@color/black"
            android:id="@+id/coverageLayout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            >
            <TextView
                android:background="@color/white"
                android:gravity="center"
                android:layout_marginStart="1dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="Coverage"
                />
            <TextView
                android:background="@color/white"
                android:id="@+id/coverageTodayTV"
                android:text="23/35"
                android:gravity="center_vertical|right"
                android:layout_marginStart="1dp"

                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"

                />
            <TextView
                android:background="@color/white"
                android:id="@+id/coverageMonthTV"
                android:text="324/365"
                android:layout_marginEnd="1dp"
                android:gravity="center_vertical|right"
                android:layout_marginStart="1dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                />
        </LinearLayout>

        <LinearLayout
            android:clickable="true"
            android:id="@+id/productivityLayout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            >
            <TextView
                android:background="@color/black"
                android:gravity="center"
                android:layout_marginStart="1dp"
                style="@style/TextViewSecondaryStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="Productivity"
                />
            <TextView
                android:id="@+id/productivityTodayTV"
                android:background="@color/black"
                android:gravity="center_vertical|right"
                android:layout_marginStart="1dp"
                style="@style/TextViewSecondaryStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="10/23"
                />
            <TextView
                android:id="@+id/productivityMonthTV"
                android:layout_marginEnd="1dp"
                android:background="@color/black"
                android:gravity="center_vertical|right"
                android:layout_marginStart="1dp"
                style="@style/TextViewSecondaryStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="165/324"
                />
        </LinearLayout >
        <LinearLayout
            android:background="@color/black"
            android:id="@+id/productLayout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            >
            <TextView
                android:background="@color/white"
                android:gravity="center"
                android:layout_marginStart="1dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="Product"
                />
            <TextView
                android:id="@+id/productTodayTV"
                android:background="@color/white"
                android:text="32/132"
                android:gravity="center_vertical|right"
                android:layout_marginStart="1dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"

                />
            <TextView
                android:id="@+id/productMonthTV"
                android:background="@color/white"
                android:text="102/132"
                android:layout_marginEnd="1dp"
                android:gravity="center_vertical|right"
                android:layout_marginStart="1dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                />
        </LinearLayout>
        <LinearLayout
            android:clickable="true"
            android:id="@+id/valueLayout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            >
            <TextView
                android:background="@color/black"
                android:gravity="center"
                android:layout_marginStart="1dp"
                style="@style/TextViewSecondaryStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="Value"
                />
            <TextView
                android:gravity="center_vertical|right"
                android:id="@+id/valueTodayTV"
                android:background="@color/black"
                android:layout_marginStart="1dp"
                style="@style/TextViewSecondaryStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="5465/6250"
                />
            <TextView
                android:gravity="center_vertical|right"
                android:id="@+id/valueMonthTV"
                android:layout_marginEnd="1dp"
                android:background="@color/black"
                android:layout_marginStart="1dp"
                style="@style/TextViewSecondaryStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="125660/174800"
                />
        </LinearLayout>
        <LinearLayout
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            >
            <TextView
                android:background="@color/white"
                android:gravity="center"
                android:layout_marginStart="1dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="Weightage"
                />
            <TextView
                android:id="@+id/weightageTodayTV"
                android:background="@color/white"
                android:text="32/132"
                android:gravity="center_vertical|right"
                android:layout_marginStart="1dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"

                />
            <TextView
                android:id="@+id/weightageMonthTV"
                android:background="@color/white"
                android:text="102/132"
                android:layout_marginEnd="1dp"
                android:gravity="center_vertical|right"
                android:layout_marginStart="1dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/black"
            android:padding="5dp" />
    </LinearLayout>


    <LinearLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        >
        <TextView
            android:clickable="true"
            android:id="@+id/textViewInvoiceNo"
            android:gravity="center"
            android:layout_marginStart="1dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:text=""
            />
        <TextView
            android:clickable="true"
            android:id="@+id/textViewInvoice"
            android:gravity="center"
            android:layout_marginStart="1dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:text=""
            />
    </LinearLayout>
    <!--    layout ends-->
    <LinearLayout
        android:visibility="gone"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        >
        <TextView
            android:gravity="center"
            android:layout_marginStart="1dp"
            style="@style/TextViewSecondaryStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:text="Rate Based On"
            />
    </LinearLayout>
    <LinearLayout
        android:visibility="gone"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.5"
        android:orientation="vertical"
        android:layout_marginTop="1dp">
        <TextView
            android:id="@+id/textViewRateTypeValue"
            android:layout_marginStart="11dp"
            style="@style/TextViewSecondaryStyle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:text=""
            />
        <TextView
            android:id="@+id/textViewDepotValue"
            android:layout_marginStart="11dp"
            style="@style/TextViewSecondaryStyle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:text=""
            />
        <TextView
            android:id="@+id/textViewTransportMode"
            android:layout_marginStart="11dp"
            style="@style/TextViewSecondaryStyle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:text=""
            />
        <TextView
            android:id="@+id/textViewLoadability"
            android:layout_marginStart="11dp"
            style="@style/TextViewSecondaryStyle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:text=" "
            />

    </LinearLayout>
    <LinearLayout
        android:visibility="gone"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight=".8"
        android:orientation="horizontal"
        android:layout_marginTop="1dp">
        <TextView
            android:id="@+id/textViewPreviousOutstanding"
            style="@style/TextViewSecondaryStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:text="Bargain Limit(MT) : "
            android:layout_marginStart="11dp"
            />
        <TextView
            android:id="@+id/textViewCalculatedSaudaLimit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            style="@style/TextViewSecondaryStyle"
            android:text=""
            android:gravity="right|center_vertical"
            android:layout_marginRight="8dp"
            />
    </LinearLayout>
    <LinearLayout
        android:visibility="gone"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight=".8"
        android:orientation="horizontal"
        android:layout_marginTop="1dp">
        <TextView
            android:id="@+id/textViewPreviousOutstandingc"
            style="@style/TextViewSecondaryStyle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"

            android:text="Pending Quantity(MT) : "
            android:layout_marginStart="11dp"
            />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:layout_weight="1">

                <ImageView
                    android:visibility="gone"
                    android:id="@+id/pendingbargainQtyIV"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentStart="true"
                    android:layout_gravity="center"
                    android:layout_marginEnd="1dp"
                    android:clickable="true"
                    android:onClick="showPendingBargain"
                    android:src="@android:drawable/ic_dialog_info"></ImageView>
            </RelativeLayout>

            <TextView
                android:id="@+id/textViewCalculatedPendingQty"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                style="@style/TextViewSecondaryStyle"
                android:text=""
                android:gravity="left|center_vertical"
                android:layout_marginRight="8dp"
                />
        </LinearLayout>


    </LinearLayout>
    <LinearLayout
        android:visibility="gone"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight=".8"
        android:orientation="horizontal"
        android:layout_marginTop="1dp">
        <TextView
            android:id="@+id/textViewPreviousOutstandin"
            style="@style/TextViewSecondaryStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:text="Max Allocation(MT) : "
            android:layout_marginStart="11dp"
            />
        <TextView
            android:id="@+id/textViewCalculateedAllocation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            style="@style/TextViewSecondaryStyle"
            android:text=""
            android:gravity="right|center_vertical"
            android:layout_marginRight="8dp"
            />
    </LinearLayout>
        <LinearLayout
            android:id="@+id/body_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="3dp"
            android:paddingTop="10dp"
            android:paddingRight="3dp"
            android:weightSum="11">

            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/report_customer_bg"
                android:orientation="vertical"
                android:paddingLeft="5dp"
                android:paddingTop="1dp"
                android:paddingRight="5dp"
                android:id="@+id/saudaBookedThroughLayout">

                <TextView
                    android:id="@+id/textViewTitleDirectorBroker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="3dp"
                    android:paddingBottom="6dp"
                    android:text="Sauda booked through"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FF8C00"
                    android:padding="5dp" />

                <RadioGroup
                    android:id="@+id/radioSelectSBT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="1dp">

                    <RadioButton
                        android:id="@+id/radioDirect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Direct"
                        android:textColor="#0000FF" />

                    <RadioButton
                        android:id="@+id/radioBroker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Broker"
                        android:textColor="#0000FF" />

                </RadioGroup>

                <TextView
                    android:id="@+id/textViewChosenVertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:text="Vertical: "
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutverticalSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/report_customer_bg"
                android:visibility="gone"
                >

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="1dp"
                    android:text="Choose Vertical: "
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

                <Spinner
                    android:id="@+id/spinner"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:prompt="@string/vertical_spinner_text">

                </Spinner>
            </LinearLayout>

            <!--broker/route/customer name layout-->
            <LinearLayout
                android:id="@+id/routeCustomerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textViewBrokerOrDirectValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:text="Direct"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

                <TextView
                    android:id="@+id/textViewRouteValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:text="Route Name"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

                <TextView
                    android:id="@+id/textViewCustomerValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:text="Customer Name"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

            </LinearLayout>

            <!--despatch origin layout-->
            <LinearLayout
                android:id="@+id/despatchOriginLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/report_customer_bg"
                android:orientation="vertical"
                android:paddingLeft="5dp"
                android:paddingTop="1dp"
                android:paddingRight="5dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textViewDespatchOrigin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="3dp"
                    android:paddingBottom="6dp"
                    android:text="Despatch Origin"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FF8C00"
                    android:padding="5dp" />

                <RadioGroup
                    android:id="@+id/radioGrpDespatchOrigin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioFactory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Factory"
                        android:textColor="#0000FF" />

                    <RadioButton
                        android:id="@+id/radioDepot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Depot"
                        android:textColor="#0000FF" />

                </RadioGroup>

            </LinearLayout>

            <!--dispatch origin value layout-->
            <LinearLayout
                android:id="@+id/despatchOriginValueLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textViewDespatchOriginValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:text="Despatch Origin: Factory"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ExForSelectionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/report_customer_bg"
                android:orientation="vertical"
                android:paddingLeft="5dp"
                android:paddingTop="7dp"
                android:paddingRight="5dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textViewTitleRBT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="3dp"
                    android:paddingBottom="6dp"
                    android:text="Rate Based On"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FF8C00" />

                <RadioGroup

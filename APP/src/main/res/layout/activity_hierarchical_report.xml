                android:padding="5dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/bargainLimitTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.93"
                    android:text="Sauda Limit (MT)    "
                    android:textColor="#003399" />

                <TextView
                    android:id="@+id/textViewCalculatedSaudaLimit1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.09"
                    android:text="TextView"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#B22222" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pending_qty_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/report_customer_bg"
                android:padding="5dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.93"
                    android:text="Pending Quantity (MT)    "
                    android:textColor="#003399" />

                <TextView
                    android:id="@+id/textViewCalculatedPendingQty1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.09"
                    android:text="TextView"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#B22222" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/allocation_cont_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/report_customer_bg"
                android:padding="5dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textViewAllocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.93"
                    android:text="Max Allocation (MT)"
                    android:textColor="#003399" />

                <TextView
                    android:id="@+id/textViewCalculateedAllocation1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.09"
                    android:text="TextView"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#B22222" />
            </LinearLayout>

        </LinearLayout>
    <LinearLayout

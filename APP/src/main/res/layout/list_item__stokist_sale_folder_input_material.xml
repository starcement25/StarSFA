<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:orientation="horizontal"
    android:layout_gravity="center"
    android:gravity="center"
    android:layout_marginRight="2dp"
    android:layout_marginLeft="2dp">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:orientation="vertical"
        android:padding="1dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/list_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="4dp"
            android:layout_weight="2"
            android:text="AIRWAVE3"
            android:textColor="@color/black"
            android:textSize="14dp"/>
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.5"
        android:orientation="vertical"
        android:padding="1dp"
        android:visibility="visible">

        <EditText
            android:elevation="3dp"
            android:id="@+id/etProdQty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:background="@drawable/edit_text_background_grey_border"
            android:inputType="numberDecimal"
            android:textColor="@color/black"
            android:textSize="12dp"
            android:layout_margin="5dp"/>
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.5"
        android:orientation="vertical"
        android:padding="1dp"
        android:visibility="visible">

        <EditText
            android:elevation="3dp"
            android:id="@+id/etFoldeerQty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:background="@drawable/edit_text_background_grey_border"
            android:inputType="numberDecimal"
            android:textColor="@color/black"
            android:textSize="12dp"
            android:layout_margin="5dp"/>
    </FrameLayout>

    <RelativeLayout
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight=".3"
        android:gravity="center">

        <ImageView
            android:id="@+id/addtocartIV"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:gravity="center"
            android:src="@drawable/addtocart_listview"
            android:text="10 pcs"
            android:textColor="@color/black" />
    </RelativeLayout>

    <TextView
        android:id="@+id/invisibleTVProdCode"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="" />
</LinearLayout>
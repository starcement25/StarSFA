<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="wrap_content"
    android:background="#DCE8F6"
    android:orientation="vertical"
    android:padding="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp">

        <ImageView
            android:id="@+id/imageView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/info" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="5dp"
            android:text="Medium Text"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="#003399" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/qnt_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textViewQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1.07"
            android:text="Quantity"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="#003399" />

        <EditText
            android:id="@+id/editTextQuantity"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:imeOptions="actionDone"
            android:textColor="#003399" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mrp_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textViewSaleRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1.07"
            android:text="Sale Rate"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="#003399" />

        <EditText
            android:id="@+id/editTextSaleRate"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:imeOptions="actionDone"
            android:textColor="#003399" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/disc_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textViewTD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1.07"
            android:text="Trade Discount"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="#003399" />

        <EditText
            android:id="@+id/edittextTD"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:imeOptions="actionDone"
            android:textColor="#003399" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/layoutFC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textViewFC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1.07"
            android:text="Freight Charge"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="#003399" />

        <EditText
            android:id="@+id/editTextFC"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:imeOptions="actionDone"
            android:textColor="#003399" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/liquidationDiscountLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1.07"
            android:text="Liquidation Discount"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="#003399" />

        <EditText
            android:id="@+id/mEditTextLiquidationDiscount"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:imeOptions="actionDone"
            android:textColor="#003399" />

    </LinearLayout>

    <Button
        android:id="@+id/btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/norm_btn_bg"
        android:text="Submit" />

</LinearLayout>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include
        layout="@layout/header_common_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:id="@+id/sv_1"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!--tour type layout-->
            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:text="Tour Type:"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#003399" />

                <RadioGroup
                    android:id="@+id/radio_tour_type"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/radio0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EX"
                        android:textColor="#003399"
                        android:checked="true"
                        />
                    <RadioButton
                        android:id="@+id/radio1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OS"
                        android:textColor="#003399" />
                </RadioGroup>

            </LinearLayout>

            <!--date/date from layout-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"
                    android:text="Date:"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/norm_btn_bg"
                    android:onClick="chooseDate"
                    android:text="dd/MM/yyyy"
                    android:textColor="#003399" />

            </LinearLayout>

            <!--date to layout-->
            <LinearLayout
                android:id="@+id/toDateLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="To Date:"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_date_to"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/norm_btn_bg"
                    android:onClick="chooseToDate"
                    android:text="dd/MM/yyyy"
                    android:textColor="#003399" />

            </LinearLayout>

            <!--place from layout-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Place From:"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_from"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:padding="10dp"
                    android:textColor="#003399"/>
            </LinearLayout>

            <!--place to layout-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Place To:"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_to"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:padding="10dp"
                    android:textColor="#003399"/>

            </LinearLayout>

            <!--travel mode layout-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Travel Mode:"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_transport_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/norm_btn_bg"
                    android:onClick="chooseTravelMode"
                    android:text="MODE"
                    android:textColor="#003399" />

            </LinearLayout>

            <!--lodging attachment-->
            <LinearLayout
                android:id="@+id/travelAttachmentLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_add_attachment_travel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/norm_btn_bg"
                    android:onClick="addAttachmentTravel"
                    android:text="Trans Attachment"
                    android:textColor="#003399" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/travelAttachmentImageView1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/travelAttachmentImageView2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/travelAttachmentImageView3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="1dp"
                        android:layout_weight="1" />
                </LinearLayout>

            </LinearLayout>

            <!--from kms layout-->
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/fromKmsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="From(Kms):"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_from_kms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:imeOptions="actionNext"
                    android:padding="10dp"
                    android:inputType="numberDecimal"
                    android:textColor="#003399"/>

            </LinearLayout>

            <!--to kms layout-->
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/toKmsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="To(Kms):"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_to_kms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:padding="10dp"
                    android:textColor="#003399"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/dailyAsistanceLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:padding="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Daily Assistance:"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_daily_assistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:imeOptions="actionNext"
                    android:maxLength="10"
                    android:padding="10dp"
                    android:textColor="#003399" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/kmTravelLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:padding="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Km Travel(one way):"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_km_travel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:maxLength="10"
                    android:padding="10dp"
                    android:textColor="#003399" />
            </LinearLayout>

            <!--fair layout-->
            <LinearLayout
                android:id="@+id/fairLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fare:"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_transport_fare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:drawableLeft="@drawable/rupee_icon"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:maxLength="10"
                    android:padding="10dp"
                    android:textColor="#003399" />
            </LinearLayout>

            <!--fooding allowance(D/A) layout-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Food:"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_fooding_allowance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:drawableLeft="@drawable/rupee_icon"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:maxLength="10"
                    android:padding="10dp"
                    android:textColor="#003399" />
            </LinearLayout>

            <!--hotel expense layout-->
            <LinearLayout
                android:id="@+id/lodgingExpenseLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lodging:"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_hotel_charges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:drawableLeft="@drawable/rupee_icon"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:maxLength="10"
                    android:padding="10dp"
                    android:textColor="#003399" />
            </LinearLayout>

            <!--conv. layout-->
            <LinearLayout
                android:id="@+id/convLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:text="Local Conveyance:"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_local_conv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:drawableLeft="@drawable/rupee_icon"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:maxLength="10"
                    android:padding="10dp"
                    android:textColor="#003399" />
            </LinearLayout>

            <!--lodging attachment-->
            <LinearLayout
                android:id="@+id/lodgingAttachmentLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_add_attachment_lodging"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/norm_btn_bg"
                    android:onClick="addAttachmentLodging"
                    android:text="lodging Attachment"
                    android:textColor="#003399" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/lodgingAttachmentImageView1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/lodgingAttachmentImageView2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/lodgingAttachmentImageView3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="1dp"
                        android:layout_weight="1" />
                </LinearLayout>

            </LinearLayout>

            <!--da attachment-->
            <LinearLayout
                android:id="@+id/daAttachmentLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_add_attachment_da"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/norm_btn_bg"
                    android:onClick="addAttachmentDa"
                    android:text="DA Attachment"
                    android:textColor="#003399" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/daAttachmentImageView1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/daAttachmentImageView2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/daAttachmentImageView3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="1dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <!--other expenses layout-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Others:"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_other_expenses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:drawableLeft="@drawable/rupee_icon"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:maxLength="10"
                    android:padding="10dp"
                    android:textColor="#003399" />
            </LinearLayout>

            <!--particulars layout-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total:"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_particulars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:imeOptions="actionNext"
                    android:inputType="none"
                    android:padding="10dp"
                    android:textColor="#003399" />
            </LinearLayout>

            <!--remarks layout-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Remarks:"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_remarks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:padding="10dp"
                    android:textColor="#003399" />
            </LinearLayout>

            <!--misc layout-->
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/miscLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Misc:"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_misc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:imeOptions="actionNext"
                    android:inputType="textMultiLine"
                    android:padding="10dp"
                    android:text=""
                    android:textColor="#003399" />
            </LinearLayout>

            <!--other attachment-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <Button
                    android:id="@+id/btn_add_attachment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/norm_btn_bg"
                    android:onClick="addAttachment"
                    android:text="Attachments"
                    android:textColor="#003399" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/attachmentImageView1"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/attachmentImageView2"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginLeft="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/attachmentImageView3"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginLeft="1dp"
                        android:layout_weight="1" />
                </LinearLayout>

            </LinearLayout>

            <!--fuel bill attachment-->
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/fuelBillAttachmentLL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <Button
                    android:id="@+id/btn_fuel_bill_attachment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/norm_btn_bg"
                    android:onClick="addAttachmentFuelBill"
                    android:text="Fuel Bill"
                    android:textColor="#003399" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/fuelBillattachmentImageView"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_weight="1" />

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_submit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="5dp"
        android:background="@drawable/norm_btn_bg"
        android:onClick="submit"
        android:text="Submit"
        android:textColor="#003399" />

    <include
        layout="@layout/footer_common_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/white_background"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:layout_weight=".5"
            android:text="Customer Code"
            android:textColor="@color/black"
            android:textSize="10dp" />

        <TextView
            android:id="@+id/customerCode"
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#666666"
            android:textSize="10dp" />
    </LinearLayout>

    <View
        android:layout_width="wrap_content"
        android:layout_height="5dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:layout_weight=".5"
            android:text="Customer Name"
            android:textColor="@color/black"
            android:textSize="10dp" />

        <TextView
            android:id="@+id/customerName"
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#666666"
            android:textSize="10dp" />
    </LinearLayout>

    <View
        android:layout_width="wrap_content"
        android:layout_height="5dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:layout_weight=".5"
            android:text="Credit Limit"
            android:textColor="@color/black"
            android:textSize="10dp" />

        <TextView
            android:id="@+id/creditLimit"
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#666666"
            android:textSize="10dp" />
    </LinearLayout>

    <View
        android:layout_width="wrap_content"
        android:layout_height="5dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0sp"
                android:layout_height="wrap_content"
                android:layout_weight=".5"
                android:text="Utilised CL"
                android:textColor="@color/black"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/utilisedCreditLimit"
                android:layout_width="0sp"
                android:layout_height="wrap_content"
                android:layout_weight=".75"
                android:textColor="#666666"
                android:textSize="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0sp"
                android:layout_height="wrap_content"
                android:layout_weight=".5"
                android:text="Available CL"
                android:textColor="@color/black"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/availableCreditLimit"
                android:layout_width="0sp"
                android:layout_height="wrap_content"
                android:layout_weight=".75"
                android:textColor="#666666"
                android:textSize="10dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
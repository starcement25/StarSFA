<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:fitsSystemWindows="true"
    tools:context=".new_activity.raise_issue.RaiseIssueActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/header_dark_bluebackup"
            android:orientation="horizontal"
            android:padding="3dp">

            <Button
                android:id="@+id/backButton"
                android:layout_width="35dp"
                android:layout_height="30dp"
                android:layout_gravity="left|center_vertical"
                android:background="@drawable/back_bg" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Raise New Issue"
                android:textColor="#FFF"
                android:textSize="18sp" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="10dp"
            android:orientation="vertical">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0sp"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Branch Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/branchButton"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:text="Branch"
                            android:background="@drawable/button_background"
                            android:textAllCaps="false" />

                        <TextView
                            android:id="@+id/branchText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/colorOrangeAppCommon"
                            android:textSize="14dp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="10dp" />
                    </LinearLayout>

                    <!-- Category Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/categoryButton"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:text="Category"
                            android:background="@drawable/button_background"
                            android:textAllCaps="false" />

                        <TextView
                            android:id="@+id/categoryText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/colorOrangeAppCommon"
                            android:textSize="14dp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="10dp" />
                    </LinearLayout>

                    <!-- Dealer/Sub-Dealer Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/dealerSubDealerButton"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:text="Customer Name"
                            android:background="@drawable/button_background"
                            android:textAllCaps="false" />

                        <TextView
                            android:id="@+id/dealerSubDealerText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/colorOrangeAppCommon"
                            android:textSize="14dp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="10dp" />
                    </LinearLayout>

                    <!-- State EditText -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stateText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="State"
                            android:textColor="@color/black"
                            android:textSize="12dp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="4dp" />

                        <EditText
                            android:id="@+id/stateEditText"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:background="@drawable/edit_text_background"
                            android:elevation="5dp"
                            android:hint="state"
                            android:paddingHorizontal="10dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/grey"
                            android:textSize="14dp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="10dp" />
                    </LinearLayout>

                    <!-- District EditText -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/districtText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="District"
                            android:textColor="@color/black"
                            android:textSize="12dp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="4dp" />

                        <EditText
                            android:id="@+id/districtEditText"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:background="@drawable/edit_text_background"
                            android:elevation="5dp"
                            android:hint="District"
                            android:paddingHorizontal="10dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/grey"
                            android:textSize="14dp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="10dp" />
                    </LinearLayout>

                    <!-- Escalated Department Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/escalatedDepartmentButton"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:text="Escalated Department"
                            android:background="@drawable/button_background"
                            android:textAllCaps="false" />

                        <TextView
                            android:id="@+id/escalatedDepartmentText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/colorOrangeAppCommon"
                            android:textSize="14dp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="10dp" />
                    </LinearLayout>

                    <!-- Issue Description EditText -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/issueDescriptionText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Issue Description"
                            android:textColor="@color/black"
                            android:textSize="12dp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="4dp" />

                        <EditText
                            android:id="@+id/issueDescriptionEditText"
                            android:layout_width="match_parent"
                            android:layout_height="105dp"
                            android:background="@drawable/edit_text_background"
                            android:elevation="5dp"
                            android:hint="Issue Description"
                            android:padding="10dp"
                            android:textColor="@color/black"
                            android:gravity="top"
                            android:textColorHint="@color/grey"
                            android:textSize="14dp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="10dp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="0sp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/norm_btn_bg"
                    android:text="Submit"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>

        <include
            layout="@layout/footer_common_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</RelativeLayout>
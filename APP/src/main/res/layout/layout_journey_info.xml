<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="fill_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="2dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">
            <Button
                android:visibility="gone"
                android:id="@+id/back"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:layout_marginLeft="2dp"
                android:background="@drawable/ic_arrow_back_black_24dp" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_weight="0.94"
                android:text="Medium Text"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/black" />
            <ImageView
                android:id="@+id/image_cancel"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_gravity="right|center_vertical"
                android:src="@drawable/bk_normbackup"
                android:visibility="gone" />
        </LinearLayout>

        <EditText
            android:id="@+id/autoCompleteTextView1"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:drawableLeft="@drawable/searchx"
            android:ems="10"
            android:hint="Type Here to Search"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:nextFocusLeft="@id/autoCompleteTextView1"
            android:nextFocusUp="@id/autoCompleteTextView1"
            android:textColor="#003399"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/blue_light"
            android:padding="10dp" />
    </LinearLayout>
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:elevation="3dp"
        >
        <EditText
            android:visibility="gone"
            android:id="@+id/StartingKmTextView"
            android:layout_width="fill_parent"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:paddingStart="4dp"
            android:ems="10"
            android:hint="Starting Km"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:textColor="#003399"
            android:background="@drawable/edit_text_background_grey_border"
            />
        <EditText
            android:visibility="gone"
            android:id="@+id/EndingKmTextView"
            android:layout_width="fill_parent"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:paddingStart="4dp"
            android:ems="10"
            android:hint="Ending Km"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:textColor="#003399"
            android:background="@drawable/edit_text_background_grey_border"
            />
        <LinearLayout
            android:visibility="gone"
            android:id="@+id/odometerPicLayout"
            android:background="@drawable/edit_text_background_grey_border"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal">

            <TextView
                android:layout_marginStart="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="0.20"
                android:text="Odometer Picture"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/black" />

            <Button
                android:layout_marginEnd="4dp"
                android:id="@+id/buttonAddPicOutlet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="0.20"
                android:textColor="@color/white"
                android:textSize="12dp"
                android:background="@color/blue_light"
                android:ems="10"
                android:maxLines="2"
                android:text="Upload" />

        </LinearLayout>
        <ImageView
            android:id="@+id/oddometerPicImageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />

        <TextView
            android:visibility="gone"
            android:id="@+id/recyclerViewHeaderTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="8dp"
            android:layout_weight="0.94"
            android:text="Necessary items to be carried"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/black" />
        <androidx.recyclerview.widget.RecyclerView
            android:visibility="gone"
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            tools:listitem="@layout/list_item_single_with_checkbox"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:layout_weight="1" />

    </LinearLayout>
</ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/blue_light"
        android:padding="10dp" />

    <Button
        android:layout_marginBottom="4dp"
        android:elevation="2dp"
        android:id="@+id/btn_generate"
        android:layout_width="164dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="5dp"
        android:textColor="@color/white"
        android:textSize="12dp"
        android:background="@color/blue_light"
        android:text="Submit" />

</LinearLayout>
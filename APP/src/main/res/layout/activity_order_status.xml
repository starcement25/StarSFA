<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/background"
    android:orientation="vertical">

    <include layout="@layout/header_layout_blue" />

    <LinearLayout
        android:id="@+id/body_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="5dp"
        android:weightSum="11">

        <LinearLayout
            android:id="@+id/filter_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="10.89"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/option_layout"
                android:layout_width="match_parent"
                android:layout_height="135dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/buttonSelectCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_margin="3dp"
                    android:textColor="#003399"
                    android:background="#FB9433"
                    android:text="Select Customer" />

                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:background="#FB9433"
                    android:textColor="#003399"
                    android:gravity="center_vertical"
                    android:id="@+id/textViewDate"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="  Date: " />

                <TextView

                    android:id="@+id/textViewCustomername"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:gravity="center_vertical"
                    android:text="  Customer:"
                    android:textColor="#003399"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:background="#F58322"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp"
                    android:id="@+id/textViewOrderNumber"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="  Order: " />

            </LinearLayout>


            <LinearLayout
                android:layout_marginTop="7dp"
                android:id="@+id/list_header_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#736F6E">

                <FrameLayout
                    android:background="#FB9433"
                    android:id="@+id/col2"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="2.5"
                    android:orientation="vertical"
                    android:padding="1dp"
                    android:visibility="visible"
                    android:layout_marginEnd="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Product Name"
                        android:textColor="#003399"
                        android:textSize="13sp" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/col3"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="1dp"
                    android:background="#FB9433"
                    android:visibility="visible"
                    android:layout_marginEnd="1dp">

                    <TextView
                        android:textColor="#003399"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|center_horizontal"
                        android:gravity="center"
                        android:text="Bkd Qty"
                        android:textSize="13sp" />
                </FrameLayout>

                <FrameLayout
                    android:layout_marginEnd="1dp"
                    android:background="@color/black"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="1dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/TextViewSecondaryStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|center_horizontal"
                        android:gravity="center"
                        android:text="Qty Dlvrd"
                        android:layout_marginEnd="1dp"

                        android:textSize="13sp" />
                </FrameLayout>

                <FrameLayout

                    android:id="@+id/col4"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="2"
                    android:background="#FB9433"
                    android:orientation="vertical"
                    android:padding="1dp"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/txt_col2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="Deliver"
                        android:textColor="#003399"
                        android:textSize="13sp" />
                </FrameLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/scrollView1"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/scrollLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"></LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!--<Button-->
        <!--android:id="@+id/buttonSubmit"-->
        <!--android:layout_width="wrap_content"-->
        <!--android:layout_height="wrap_content"-->
        <!--android:layout_gravity="center_horizontal"-->
        <!--android:background="@drawable/norm_btn_bg"-->
        <!--android:text="Submit" />-->
    </LinearLayout>

    <include
        layout="@layout/footer_common_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />

</LinearLayout>

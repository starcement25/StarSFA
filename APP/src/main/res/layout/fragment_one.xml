<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">
    <LinearLayout
    android:layout_marginTop="5dp"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:orientation="horizontal">
    <TextView
        android:gravity="center_vertical"
        android:text="Distributor: "

        android:layout_width="wrap_content"
        android:layout_height="50dp">

    </TextView>
    <androidx.cardview.widget.CardView
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="5dp"
        xmlns:card_view="http://schemas.android.com/apk/res-auto"
        card_view:cardElevation="4dp"
        android:background="@drawable/spinner_material_background"
        >

        <TextView
            android:id="@+id/tv_dealer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/left_right_margin_15dp"
            android:background="@drawable/border_grey_white"
            android:maxLines="1"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:drawableEnd="@drawable/down"
            android:clickable="true"
            android:onClick="dealer_list"
            android:text=""
            />
    </androidx.cardview.widget.CardView>

        <TextView
            android:visibility="invisible"
            android:id="@+id/cart_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="3dp"
            android:background="@drawable/badge_background"
            android:gravity="center"
            android:minWidth="24dp"
            android:minHeight="24dp"
            android:text="13"
            android:textColor="@android:color/white"
            android:textSize="10sp" />

    </LinearLayout>
    <LinearLayout
        android:layout_marginTop="5dp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">
        <TextView
            android:gravity="center_vertical"
            android:text="Route:         "
            android:layout_width="wrap_content"
            android:layout_height="50dp">

        </TextView>
        <androidx.cardview.widget.CardView
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="5dp"
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            card_view:cardElevation="4dp"
            android:background="@drawable/spinner_material_background"
            >

            <TextView
                android:id="@+id/tv_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/left_right_margin_15dp"
                android:background="@drawable/border_grey_white"
                android:maxLines="1"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:drawableEnd="@drawable/down"
                android:clickable="true"
                android:onClick="route_list"
                android:text=""
                />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/cart_badge_route"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="3dp"
            android:background="@drawable/badge_background"
            android:gravity="center"
            android:minWidth="24dp"
            android:minHeight="24dp"
            android:text="0"
            android:textColor="@android:color/white"
            android:textSize="10sp" />

    </LinearLayout>
    <LinearLayout
        android:layout_marginBottom="4dp"
        android:layout_marginTop="5dp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">
        <TextView
            android:gravity="center_vertical"
            android:text="Customer:  "
            android:layout_width="wrap_content"
            android:layout_height="50dp">

        </TextView>
        <androidx.cardview.widget.CardView
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="5dp"
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            card_view:cardElevation="4dp"
            android:background="@drawable/spinner_material_background"
            >

            <TextView
                android:id="@+id/tv_customer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/left_right_margin_15dp"
                android:background="@drawable/border_grey_white"
                android:maxLines="1"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:drawableEnd="@drawable/down"
                android:clickable="true"
                android:onClick="customerList"
                android:text=""
                />
        </androidx.cardview.widget.CardView>
<ImageView
    android:clickable="true"
    android:onClick="showCustomerInfo"
    android:id="@+id/customerInfo"
    android:layout_marginEnd="3dp"
    android:minWidth="24dp"
    android:minHeight="24dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/ic_info_black_24dp"
    android:gravity="center"
>

</ImageView>
    </LinearLayout>
<!--<HorizontalScrollView-->
<!--    android:layout_width="wrap_content"-->
<!--    android:layout_height="50dp">-->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabReports"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:background="@color/grey"
        app:tabGravity="fill"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/black"
        app:tabIndicatorColor="@color/text_color"
        app:tabRippleColor="@null"/>
<!--</HorizontalScrollView>-->


    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPagerOne"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        ></androidx.viewpager.widget.ViewPager>
</LinearLayout>
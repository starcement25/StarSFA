<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#999999"/>
        <TextView
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:paddingVertical="5dp"
            android:id="@+id/slNoText"
            android:text="Sl. No."
            android:textSize="12dp"
            android:gravity="center"
            android:textColor="@color/black"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#999999"/>
        <TextView
            android:layout_width="175dp"
            android:id="@+id/customerNameText"
            android:layout_height="wrap_content"
            android:paddingVertical="5dp"
            android:text="Customer Name"
            android:textSize="12dp"
            android:gravity="center"
            android:textColor="@color/black"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#999999"/>
        <TextView
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:id="@+id/customerCodeText"
            android:paddingVertical="5dp"
            android:text="Customer Code"
            android:textSize="12dp"
            android:gravity="center"
            android:textColor="@color/black"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#999999"/>
        <TextView
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:paddingVertical="5dp"
            android:id="@+id/universeTypeText"
            android:text="Universe Type"
            android:textSize="12dp"
            android:gravity="center"
            android:textColor="@color/black"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#999999"/>
        <TextView
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:id="@+id/stateText"
            android:paddingVertical="5dp"
            android:text="State"
            android:textSize="12dp"
            android:gravity="center"
            android:textColor="@color/black"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#999999"/>
        <TextView
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:paddingVertical="5dp"
            android:id="@+id/districtText"
            android:text="District"
            android:textSize="12dp"
            android:gravity="center"
            android:textColor="@color/black"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#999999"/>
        <TextView
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:paddingVertical="5dp"
            android:id="@+id/blockText"
            android:text="Block"
            android:textSize="12dp"
            android:gravity="center"
            android:textColor="@color/black"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#999999"/>
        <TextView
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:paddingVertical="5dp"
            android:id="@+id/gramPanchayatText"
            android:text="Gram Panchayat"
            android:textSize="12dp"
            android:gravity="center"
            android:textColor="@color/black"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#999999"/>
        <RelativeLayout
            android:layout_width="100dp"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:paddingVertical="5dp"
                android:id="@+id/approvalButton"
                android:background="@drawable/button_background2"
                android:text="Approve"
                android:textSize="12dp"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:textColor="@color/black"/>
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:paddingVertical="5dp"
                android:id="@+id/approvedText"
                android:text="Approved"
                android:textSize="12dp"
                android:gravity="center"
                android:textColor="@color/black"/>
        </RelativeLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#999999"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#999999"/>
</LinearLayout>
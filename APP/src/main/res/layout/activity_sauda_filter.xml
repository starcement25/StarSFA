<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include
        layout="@layout/header_common_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/body_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="3dp"
            android:paddingTop="10dp"
            android:paddingRight="3dp"
            android:weightSum="11">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/report_customer_bg"
                android:orientation="vertical"
                android:paddingLeft="5dp"
                android:paddingTop="4dp"
                android:paddingRight="5dp">

                <LinearLayout
                    android:id="@+id/layoutverticalSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="1dp"
                        android:text="Choose Vertical: "
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textColor="#0000FF" />

                    <Spinner
                        android:id="@+id/spinner"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:prompt="@string/vertical_spinner_text">

                    </Spinner>
                </LinearLayout>

                <TextView
                    android:id="@+id/textViewTitleDirectorBroker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="3dp"
                    android:paddingBottom="6dp"
                    android:text="Sauda booked through"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FF8C00"
                    android:padding="5dp" />

                <RadioGroup
                    android:id="@+id/radioSelectSBT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="2dp">

                    <RadioButton
                        android:id="@+id/radioDirect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Direct"
                        android:textColor="#0000FF" />

                    <RadioButton
                        android:id="@+id/radioBroker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Broker"
                        android:textColor="#0000FF" />

                </RadioGroup>

                <TextView
                    android:id="@+id/textViewChosenVertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:text="Vertical: "
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF"
                    android:visibility="gone" />
            </LinearLayout>

            <!--broker/route/customer name layout-->
            <LinearLayout
                android:id="@+id/routeCustomerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textViewBrokerOrDirectValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:text="Direct"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

                <TextView
                    android:id="@+id/textViewRouteValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:text="Route Name"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

                <TextView
                    android:id="@+id/textViewCustomerValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:text="Customer Name"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

            </LinearLayout>

            <!--despatch origin layout-->
            <LinearLayout
                android:id="@+id/despatchOriginLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/report_customer_bg"
                android:orientation="vertical"
                android:paddingLeft="5dp"
                android:paddingTop="4dp"
                android:paddingRight="5dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textViewDespatchOrigin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="3dp"
                    android:paddingBottom="6dp"
                    android:text="Despatch Origin"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FF8C00"
                    android:padding="5dp" />

                <RadioGroup
                    android:id="@+id/radioGrpDespatchOrigin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioFactory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Factory"
                        android:textColor="#0000FF" />

                    <RadioButton
                        android:id="@+id/radioDepot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Depot"
                        android:textColor="#0000FF" />

                </RadioGroup>

            </LinearLayout>

            <!--dispatch origin value layout-->
            <LinearLayout
                android:id="@+id/despatchOriginValueLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textViewDespatchOriginValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:text="Despatch Origin: Factory"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ExForSelectionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/report_customer_bg"
                android:orientation="vertical"
                android:paddingLeft="5dp"
                android:paddingTop="4dp"
                android:paddingRight="5dp">

                <TextView
                    android:id="@+id/textViewTitleRBT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="3dp"
                    android:paddingBottom="6dp"
                    android:text="Rate Based On"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FF8C00" />

                <RadioGroup
                    android:id="@+id/radioSelectRBO"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="2dp">

                    <RadioButton
                        android:id="@+id/radioEX"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EX"
                        android:textColor="#0000FF" />

                    <RadioButton
                        android:id="@+id/radioFOR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FOR"
                        android:textColor="#0000FF" />

                </RadioGroup>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/report_customer_bg"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="3dp"
                    android:paddingBottom="6dp"
                    android:text="Rate Based On"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FF8C00" />

                <TextView
                    android:id="@+id/textViewRateTypeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:text="Rate"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

                <TextView
                    android:id="@+id/textViewDepotValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:text="Depo Name"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF" />

                <TextView
                    android:id="@+id/textViewLoadabilityTons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:text="Vehicle Size"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0000FF"
                    android:visibility="gone" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/sauda_limit_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/report_customer_bg"
                android:padding="5dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/bargainLimitTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.93"
                    android:text="Sauda Limit (MT)    "
                    android:textColor="#003399" />

                <TextView
                    android:id="@+id/textViewCalculatedSaudaLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.09"
                    android:text="TextView"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#B22222" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pending_qty_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/report_customer_bg"
                android:padding="5dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.93"
                    android:text="Pending Quantity (MT)    "
                    android:textColor="#003399" />

                <TextView
                    android:id="@+id/textViewCalculatedPendingQty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.09"
                    android:text="TextView"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#B22222" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/allocation_cont_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/report_customer_bg"
                android:padding="5dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textViewAllocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.93"
                    android:text="Max Allocation (MT)"
                    android:textColor="#003399" />

                <TextView
                    android:id="@+id/textViewCalculateedAllocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.09"
                    android:text="TextView"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#B22222" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>


    <Button
        android:id="@+id/btn_Submi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/norm_btn_bg"
        android:text="Submit" />


    <include
        layout="@layout/footer_common_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
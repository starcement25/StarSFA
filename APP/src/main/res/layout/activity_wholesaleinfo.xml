<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/background"
    android:orientation="vertical">

    <include
        layout="@layout/header_common_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/body_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="3dp"
        android:paddingTop="5dp"
        android:paddingRight="3dp"
        android:weightSum="11">

        <LinearLayout
            android:id="@+id/list_header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#736F6E">

            <FrameLayout
                android:id="@+id/frameLayoutSelectCustomer"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="0.50"
                android:background="#FFE4B5"
                android:orientation="vertical"
                android:padding="1dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/txt_col3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:text="Select Customer"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#003399"
                    android:textSize="13sp" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/textViewCustomerValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:padding="1dp"
                android:text="Customer Name"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="#003399" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FF8C00"
                android:padding="5dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="0.55"
                android:text="Debit Note Collected"
                android:textColor="#003399"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/radioSelectDebitNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.45"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="2dp">

                <RadioButton
                    android:id="@+id/radioEX"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="Yes"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/radioFOR"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="No"
                    android:textColor="#003399"
                    android:textSize="15sp" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.55"
                android:text="Last Debit Not Received"
                android:textColor="#003399"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/editTextMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:layout_weight="0.20"
                android:background="@drawable/edit_text_background"
                android:hint="mm"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLength="2"
                android:padding="10dp"
                android:textColor="#003399" />

            <EditText
                android:id="@+id/editTextYear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.25"
                android:background="@drawable/edit_text_background"
                android:hint="yyyy"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLength="4"
                android:padding="10dp"
                android:textColor="#003399" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="0.55"
                android:text="Closing Stock Value"
                android:textColor="#003399"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/editTextClosingStockValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.45"
                android:background="@drawable/edit_text_background"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLength="12"
                android:padding="10dp"
                android:textColor="#003399" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="0.55"
                android:text="Log Book"
                android:textColor="#003399"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/radioSelectLogBook"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.45"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="2dp">

                <RadioButton
                    android:id="@+id/radioEX"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="Yes"
                    android:textColor="#003399"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/radioFOR"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="No"
                    android:textColor="#003399"
                    android:textSize="15sp" />
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>
    <!-- </ScrollView> -->

    <Button
        android:id="@+id/btn_Submi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/norm_btn_bg"
        android:text="Submit" />

    <include
        layout="@layout/footer_common_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include
        layout="@layout/header_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/body_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="3dp"
        android:paddingTop="2dp"
        android:paddingRight="3dp"
        android:weightSum="11">

        <LinearLayout
            android:id="@+id/list_header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#736F6E">

            <FrameLayout
                android:id="@+id/frameLayoutSelectRoute"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="0.50"
                android:background="#E0FFFF"
                android:orientation="vertical"
                android:padding="1dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/txt_col3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:text="Select Route"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#003399"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameLayoutSelectCustomer"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="0.50"
                android:background="#FFE4B5"
                android:orientation="vertical"
                android:padding="1dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/txt_col3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:text="Select Customer"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#003399"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameLayoutSwapDay"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="0.50"
                android:background="#E0FFFF"
                android:orientation="vertical"
                android:padding="1dp"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:text="Swap"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#003399"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameLayoutAddCustomer"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="0.50"
                android:background="#FFA4B5"
                android:orientation="vertical"
                android:padding="1dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/txt_col3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:text="Add Customer"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#003399"
                    android:textSize="13sp" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/report_customer_bg"
            android:orientation="vertical"
            android:paddingTop="3dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/textViewTitleDirectorBroker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="Customer Information"
                android:textColor="#0000FF"
                android:textSize="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingLeft="5dp"
                android:paddingTop="2dp"
                android:paddingRight="5dp"
                android:paddingBottom="2dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FF8C00"
                    android:padding="5dp" />

                <TextView
                    android:id="@+id/textViewRouteValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp"
                    android:paddingLeft="2dp"
                    android:text="Route Name"
                    android:textColor="#0000FF"
                    android:textSize="14dp" />

                <TextView
                    android:id="@+id/textViewCustomerVisitDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp"
                    android:paddingLeft="2dp"
                    android:text="Visit day: "
                    android:textColor="#0000FF"
                    android:textSize="14dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textViewCustomerValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:paddingLeft="2dp"
                    android:text="Customer Name"
                    android:textColor="#0000FF"
                    android:textSize="14dp" />

                <TextView
                    android:id="@+id/textViewPhone"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:paddingLeft="2dp"
                    android:text="Phone Number"
                    android:textColor="#0000FF"
                    android:textSize="14dp" />
                <TextView
                    android:id="@+id/textViewCustType"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:paddingLeft="2dp"
                    android:text=""
                    android:textColor="#0000FF"
                    android:textSize="14dp" />

                <TextView
                    android:id="@+id/textViewBargainNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:paddingLeft="2dp"
                    android:text="Dealer Name"
                    android:textColor="#0000FF"
                    android:textSize="14dp" />

                <TextView
                    android:id="@+id/textViewCreditLimitValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:paddingLeft="2dp"
                    android:text="Credit Limit"
                    android:textColor="#0000FF"
                    android:textSize="14dp" />


                <TextView
                    android:id="@+id/textViewState"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:paddingLeft="2dp"
                    android:text=""
                    android:textColor="#0000FF"
                    android:textSize="14dp" />

                <TextView
                    android:id="@+id/textViewCustGST"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:paddingLeft="2dp"
                    android:text=""
                    android:textColor="#0000FF"
                    android:textSize="14dp" />

                <TextView
                    android:id="@+id/textViewPan"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:paddingLeft="2dp"
                    android:text=""
                    android:textColor="#0000FF"
                    android:textSize="14dp" />

                <TextView
                    android:id="@+id/textViewOwnerName"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:paddingLeft="2dp"
                    android:text=""
                    android:textColor="#0000FF"
                    android:textSize="14dp" />

                <LinearLayout
                    android:id="@+id/linearLayoutOutstanding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/report_customer_bg"
                    android:orientation="vertical"
                    android:paddingLeft="1dp"
                    android:paddingTop="4dp"
                    android:paddingRight="1dp">

                    <TextView
                        android:id="@+id/textViewPreviousOutstanding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:paddingBottom="1dp"
                        android:text="Outstanding"
                        android:textColor="#0000FF"
                        android:textSize="14dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@android:color/black" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFE4B5"
                        android:divider="@drawable/divider"
                        android:showDividers="middle|beginning|end">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.00"
                            android:orientation="vertical"
                            android:padding="1dp"
                            android:visibility="visible">

                            <TextView
                                android:id="@+id/textView14"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical|center_horizontal"
                                android:gravity="center"
                                android:text="No of Invoice"
                                android:textAppearance="?android:attr/textAppearanceMedium"
                                android:textColor="#003399"
                                android:textSize="14sp" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.00"
                            android:orientation="vertical"
                            android:padding="1dp"
                            android:visibility="visible">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical|center_horizontal"
                                android:gravity="center"
                                android:text="Invoice Amount"
                                android:textAppearance="?android:attr/textAppearanceMedium"
                                android:textColor="#003399"
                                android:textSize="14sp" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/col3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="1dp"
                            android:visibility="visible">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical|center_horizontal"
                                android:gravity="center"
                                android:text="Due"
                                android:textAppearance="?android:attr/textAppearanceMedium"
                                android:textColor="#003399"
                                android:textSize="14sp" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/divider"
                        android:showDividers="middle|beginning|end">

                        <FrameLayout
                            android:id="@+id/col3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.00"
                            android:orientation="vertical"
                            android:padding="1dp"
                            android:visibility="visible">

                            <TextView
                                android:id="@+id/textViewInvoiceNo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical|center_horizontal"
                                android:gravity="center"
                                android:text="0"
                                android:textAppearance="?android:attr/textAppearanceMedium"
                                android:textColor="#003399"
                                android:textSize="14sp" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/col3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.00"
                            android:orientation="vertical"
                            android:padding="1dp"
                            android:visibility="visible">

                            <TextView
                                android:id="@+id/textViewInvoice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical|center_horizontal"
                                android:gravity="center"
                                android:text="0.0"
                                android:textAppearance="?android:attr/textAppearanceMedium"
                                android:textColor="#003399"
                                android:textSize="14sp" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/col3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="1dp"
                            android:visibility="visible">

                            <TextView
                                android:id="@+id/textViewDue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical|center_horizontal"
                                android:gravity="center"
                                android:text="0.0"
                                android:textAppearance="?android:attr/textAppearanceMedium"
                                android:textColor="#003399"
                                android:textSize="14sp" />

                        </FrameLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@android:color/black" />

                </LinearLayout>

                <TextView
                    android:id="@+id/textViewVerticalValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp"
                    android:paddingLeft="2dp"
                    android:text="Vertical Value"
                    android:textColor="#0000FF"
                    android:textSize="14dp" />

                <TextView
                    android:id="@+id/textViewBranchValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:paddingLeft="2dp"
                    android:text="Branch Value"
                    android:textColor="#0000FF"
                    android:textSize="14dp" />
                <!--customer wise target achievement block-->
                <LinearLayout
                    android:id="@+id/customerWiseTrgtAchvmntLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"

                    >

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@android:color/black" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="#F58322"
                        android:divider="@drawable/divider"
                        android:orientation="horizontal"
                        android:showDividers="middle|beginning|end">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.00"
                            android:orientation="vertical"
                            android:padding="1dp"
                            android:visibility="visible">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical|center_horizontal"
                                android:gravity="center"
                                android:text="Month"
                                android:textAppearance="?android:attr/textAppearanceMedium"
                                android:textColor="#003399"
                                android:textSize="14sp" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.00"
                            android:orientation="vertical"
                            android:padding="1dp"
                            android:visibility="visible">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical|center_horizontal"
                                android:gravity="center"
                                android:text="Target"
                                android:textAppearance="?android:attr/textAppearanceMedium"
                                android:textColor="#003399"
                                android:textSize="14sp" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"

                            android:orientation="vertical"
                            android:padding="1dp"
                            android:visibility="visible">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical|center_horizontal"
                                android:gravity="center"
                                android:text="Achievement"
                                android:textAppearance="?android:attr/textAppearanceMedium"
                                android:textColor="#003399"
                                android:textSize="14sp" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:divider="@drawable/divider"
                        android:orientation="horizontal"
                        android:showDividers="middle|beginning|end">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.00"
                            android:orientation="vertical"
                            android:padding="1dp"
                            android:visibility="visible">

                            <TextView
                                android:id="@+id/customerWiseTrgtAchvmntTvMonth"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical|center_horizontal"
                                android:gravity="center"
                                android:text="January"
                                android:textAppearance="?android:attr/textAppearanceMedium"
                                android:textColor="#003399"
                                android:textSize="14sp" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.00"
                            android:orientation="vertical"
                            android:padding="1dp"
                            android:visibility="visible">

                            <TextView
                                android:id="@+id/customerWiseTrgtAchvmntTvTarget"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical|center_horizontal"
                                android:gravity="center"
                                android:text="0.0"
                                android:textAppearance="?android:attr/textAppearanceMedium"
                                android:textColor="#003399"
                                android:textSize="14sp" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="1dp"
                            android:visibility="visible">

                            <TextView
                                android:id="@+id/customerWiseTrgtAchvmntTvAchievement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical|center_horizontal"
                                android:gravity="center"
                                android:text="0.0"
                                android:textAppearance="?android:attr/textAppearanceMedium"
                                android:textColor="#003399"
                                android:textSize="14sp" />
                        </FrameLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@android:color/black" />
                </LinearLayout>

                <!--gst layout-->
                <LinearLayout
                    android:id="@+id/linearLayoutGst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/buttonGst"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/norm_btn_bg"
                        android:text="GST Type" />

                    <TextView
                        android:id="@+id/textViewGst"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="2dp"
                        android:text="TextView"
                        android:textColor="#0000FF" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linearLayoutOrderType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/buttonOrderType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/norm_btn_bg"
                        android:text="Order Type" />

                    <TextView
                        android:id="@+id/textViewOrderType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="2dp"
                        android:text="TextView"
                        android:textColor="#0000FF" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linearLayoutFreight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/buttonFreight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/norm_btn_bg"
                        android:text="Freight" />
                    <TextView
                        android:id="@+id/textViewFreight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="2dp"
                        android:text="TextView"
                        android:textColor="#0000FF" />
                    <TextView
                        android:visibility="gone"
                        android:layout_marginStart="30dp"
                        android:id="@+id/textViewFreightAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|right"
                        android:layout_marginLeft="2dp"
                        android:text="Amount:"
                        android:textColor="#0000FF" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linearLayoutDestination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/buttonDestination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/norm_btn_bg"
                        android:text="Destination" />

                    <TextView
                        android:id="@+id/textViewDestination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="2dp"
                        android:text="TextView"
                        android:textColor="#0000FF" />

                </LinearLayout>

                    <Button
                        android:id="@+id/btn_Submi"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/pr" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/footer_common_layout" />

</LinearLayout>
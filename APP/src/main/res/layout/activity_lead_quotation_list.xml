<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:fitsSystemWindows="true"
    tools:context=".new_activity.nt_quotation.activity.lead_quotation.LeadQuotationListActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/header_dark_bluebackup"
            android:orientation="horizontal"
            android:padding="3dp">

            <Button
                android:id="@+id/backButton"
                android:layout_width="35dp"
                android:layout_height="30dp"
                android:layout_gravity="left|center_vertical"
                android:background="@drawable/back_bg" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Quotation List"
                android:textColor="#FFF"
                android:textSize="18sp" />

            <Button
                android:id="@+id/syncButton"
                android:layout_width="35dp"
                android:layout_height="30dp"
                android:layout_gravity="right|center_vertical"
                android:background="@drawable/sync" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/inactive_button"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/totalLeadText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Lead : 0"
                        android:textColor="@color/black"
                        android:textFontWeight="500"
                        android:textSize="18dp" />

                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:id="@+id/soCountLayout">

                        <LinearLayout
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:id="@+id/poPendingButton"
                            android:background="@drawable/border_design"
                            android:orientation="vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PO-Pending"
                                android:textColor="#000"
                                android:textSize="12dp" />

                            <TextView
                                android:id="@+id/pendingCountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0"
                                android:textColor="@color/black"
                                android:textFontWeight="500"
                                android:textSize="18dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="5dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:id="@+id/poRevisionButton"
                            android:background="@drawable/border_design"
                            android:orientation="vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PO-Revision"
                                android:textColor="#000"
                                android:textSize="12dp" />

                            <TextView
                                android:id="@+id/revisionCountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0"
                                android:textColor="@color/colorOrangeAppGrey"
                                android:textFontWeight="500"
                                android:textSize="18dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="5dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:id="@+id/lostLeadButton"
                            android:background="@drawable/border_design"
                            android:orientation="vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lead Lost"
                                android:textColor="#000"
                                android:textSize="12dp" />

                            <TextView
                                android:id="@+id/lostCountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0"
                                android:textColor="@color/red"
                                android:textFontWeight="500"
                                android:textSize="18dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:id="@+id/hosCountLayout">

                        <LinearLayout
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:id="@+id/poPendingButtonForHOS"
                            android:background="@drawable/border_design"
                            android:orientation="vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PO\nPending"
                                android:textColor="#000"
                                android:textSize="12dp" />

                            <TextView
                                android:id="@+id/pendingCountTextForHOS"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0"
                                android:textColor="@color/black"
                                android:textFontWeight="500"
                                android:textSize="18dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="5dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:id="@+id/poReceivedButtonForHOS"
                            android:background="@drawable/border_design"
                            android:orientation="vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PO\nReceived"
                                android:textColor="#000"
                                android:textSize="12dp" />

                            <TextView
                                android:id="@+id/receivedCountTextForHOS"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0"
                                android:textColor="@color/colorOrangeAppGrey"
                                android:textFontWeight="500"
                                android:textSize="18dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="5dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:id="@+id/poRevisionButtonForHOS"
                            android:background="@drawable/border_design"
                            android:orientation="vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PO\nRevision"
                                android:textColor="#000"
                                android:textSize="12dp" />

                            <TextView
                                android:id="@+id/revisionCountTextForHOS"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0"
                                android:textColor="@color/colorOrangeAppGrey"
                                android:textFontWeight="500"
                                android:textSize="18dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="5dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:id="@+id/lostLeadButtonForHOS"
                            android:background="@drawable/border_design"
                            android:orientation="vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lead\nLost"
                                android:textColor="#000"
                                android:textSize="12dp" />

                            <TextView
                                android:id="@+id/lostCountTextForHOS"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0"
                                android:textColor="@color/red"
                                android:textFontWeight="500"
                                android:textSize="18dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/leadGenerationList"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lostOrderReasonPopupLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#90000000"
        android:gravity="bottom"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/back1"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reason of lost lead"
                    android:textColor="@color/black"
                    android:textFontWeight="500"
                    android:textSize="18dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/inactive_button"
                    android:elevation="4dp"
                    android:paddingHorizontal="5dp">

                    <EditText
                        android:id="@+id/editTextLostOrderReason"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="top"
                        android:hint="Reason of lost lead"
                        android:textColor="@color/black"
                        android:textSize="13dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="10dp" />

                <Button
                    android:id="@+id/lostLeadSubmitButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/norm_btn_bg"
                    android:text="Submit"
                    android:textColor="@color/white" />
            </LinearLayout>

            <ImageView
                android:id="@+id/closeLostLeadReasonButton"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginTop="5dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/cross" />
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/poReceivePopupLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#90000000"
        android:gravity="bottom">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/back1"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PO Details"
                    android:textColor="@color/black"
                    android:textFontWeight="500"
                    android:textSize="18dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:background="@drawable/inactive_button"
                    android:elevation="2dp"
                    android:paddingHorizontal="5dp">

                    <EditText
                        android:id="@+id/editTextPoNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:hint="PO Number"
                        android:textColor="@color/black"
                        android:textSize="13dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:background="@drawable/inactive_button"
                    android:elevation="2dp"
                    android:paddingHorizontal="5dp">

                    <EditText
                        android:id="@+id/editTextPoQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="number"
                        android:hint="PO Quantity"
                        android:textColor="@color/black"
                        android:textSize="13dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="10dp" />

                <LinearLayout
                    android:id="@+id/poDateButton"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/inactive_button"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="5dp">

                    <TextView
                        android:id="@+id/poDateButtonText"
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingLeft="2dp"
                        android:text="PO date"
                        android:textColor="#000000" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/calendar"
                        app:tint="#FB9433" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="10dp" />

                <LinearLayout
                    android:id="@+id/poImageButton"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/active_button"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="2dp"
                        android:text="Pick PO Image"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/pickImageShow"
                    android:layout_width="100dp"
                    android:layout_height="100dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="10dp" />

                <Button
                    android:id="@+id/submitPoDetailsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/norm_btn_bg"
                    android:text="Submit"
                    android:textColor="@color/white" />
            </LinearLayout>

            <ImageView
                android:id="@+id/closePoDetailsButton"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginTop="5dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/cross" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
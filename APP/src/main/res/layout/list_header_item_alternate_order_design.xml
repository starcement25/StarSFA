<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="35dp"
    android:background="#F58322"
    android:divider="@drawable/divider"
    android:orientation="horizontal"

    android:layout_marginLeft="5dp">


    <TextView
        android:id="@+id/stkQty"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight=".2"
        android:gravity="center"
        android:text="Stk Qty"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="#003399"
        android:visibility="gone"
 />

    <TextView
        android:id="@+id/list_details"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight=".35"
        android:gravity="center"
        android:text="Product"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="#003399"
        android:textSize="14dp"/>


    <TextView
        android:id="@+id/etProdQty"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight=".2"
        android:gravity="center"
        android:text="Qty"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="#003399" />

    <TextView
        android:id="@+id/etWeightage"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight=".4"
        android:gravity="center"
        android:text="Weigthage"
        android:visibility="gone"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="#003399" />

    <TextView
        android:id="@+id/etProdRate"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight=".37"
        android:gravity="center"
        android:text="Rate"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="#003399" />

    <TextView
        android:id="@+id/uomTv"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight=".2"
        android:gravity="center"
        android:maxLines="2"
        android:text="UOM"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="#003399" />

    <TextView
        android:id="@+id/tv_order_plan"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight=".15"
        android:gravity="center"
        android:text="Add"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="#003399" />

</LinearLayout>
